# Database
DATABASE_URL=sqlite:///./sdr.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Groq (LLM inference)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2
GROQ_KEY_RPM=6000

# Worker
AGENT_CONCURRENCY=4
AUTO_WORKER=1

# DronaHQ (ICP Fitment + Personalisation agents)
DRONA_ICP_WEBHOOK_URL=
DRONA_ICP_API_KEY=
DRONA_PERSONALISATION_WEBHOOK_URL=
DRONA_PERSONALISATION_API_KEY=
ICP_PROVIDER=dronahq
PERSONALISATION_PROVIDER=dronahq
DRONAHQ_AUTH_HEADER=Authorization
DRONAHQ_AUTH_PREFIX=Bearer 
DRONAHQ_CONNECT_TIMEOUT_SECONDS=5
DRONAHQ_TIMEOUT_SECONDS=20

# Email sending - leave CHANNEL_MODE_EMAIL as sandbox. Real sends go through the
# scoped "Send real email" action instead, not this global switch.
CHANNEL_MODE_EMAIL=sandbox
DEMO_INBOXES=your.burner.inbox@gmail.com
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Real reply receiving (Gmail IMAP poller)
GMAIL_ADDRESS=your.burner.inbox@gmail.com
GMAIL_APP_PASSWORD=
AUTO_GMAIL_POLL=1